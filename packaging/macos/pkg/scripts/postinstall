#!/bin/bash
# alle macOS .pkg postinstall (runs as root during Apple Installer).
#
# The payload placed a hermetic, self-contained /Applications/Alle.app (native
# tray + bundled core + pinned sing-box). Nothing else is needed at install
# time: no curl|sh, no root helper, no system login item. The tray:
#   - launches at login via a per-user (SMAppService) login item it registers,
#   - starts the daemon from its bundled core on first run,
#   - offers the TUN helper as an opt-in (admin prompt) the first time TUN is
#     enabled.
# Here we just launch it for the installing user.

TRAY_APP="/Applications/Alle.app"

console_user=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -n "$console_user" ] && [ "$console_user" != "root" ]; then
    sudo -u "$console_user" open "$TRAY_APP" 2>/dev/null || true
fi

exit 0
